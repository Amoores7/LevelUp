<Window x:Class="LevelUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LevelUp"
        WindowState="Maximized"
        MinWidth="1100"
        MinHeight="700"
        Background="#F8F5FA">

    <Window.Resources>

        <!-- COLORES -->
        <SolidColorBrush x:Key="Morado" Color="#7954A1"/>
        <SolidColorBrush x:Key="MoradoOscuro" Color="#54376F"/>
        <SolidColorBrush x:Key="Lavanda" Color="#EEE5F5"/>
        <SolidColorBrush x:Key="Rosa" Color="#E9A9C5"/>
        <SolidColorBrush x:Key="RosaClaro" Color="#F9EAF1"/>
        <SolidColorBrush x:Key="Fondo" Color="#F8F5FA"/>
        <SolidColorBrush x:Key="Texto" Color="#382D43"/>
        <SolidColorBrush x:Key="Secundario" Color="#918797"/>
        <SolidColorBrush x:Key="Borde" Color="#E9E0ED"/>

        <!-- BOTONES DEL MENÚ -->
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Height" Value="47"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#655575"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5D9EF"/>
                    <Setter Property="Foreground" Value="#54376F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="BotonMorado" TargetType="Button">
            <Setter Property="Height" Value="37"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#7954A1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#68438F"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- BOTÓN SECUNDARIO -->
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Height" Value="37"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="#F0E9F5"/>
            <Setter Property="Foreground" Value="#684B83"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3D5ED"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CAMPOS DE TEXTO -->
        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="#FBF9FC"/>
            <Setter Property="BorderBrush" Value="#E5DAEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#382D43"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- TÍTULOS -->
        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#382D43"/>
        </Style>

        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#918797"/>
        </Style>

        <!-- TARJETAS -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9E0ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- LISTVIEW -->
        <Style x:Key="Lista" TargetType="ListView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9E0ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#493B53"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- TABCONTROL -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E9E0ED"/>
            <Setter Property="Foreground" Value="#54376F"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#684B83"/>
            <Setter Property="Background" Value="#EEE5F5"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7,7,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0">

                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#7954A1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ESTRUCTURA PRINCIPAL -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================== -->
        <!-- MENÚ LATERAL -->
        <!-- ====================================== -->

        <Grid Grid.Column="0" Background="#EEE5F5">

            <Grid.RowDefinitions>
                <RowDefinition Height="105"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <!-- LOGOTIPO -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="43"
                        Height="43"
                        Background="#7954A1"
                        CornerRadius="11">

                    <TextBlock Text="L"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center"
                            Margin="12,0,0,0">

                    <TextBlock Text="LevelUp"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#54376F"/>

                    <TextBlock Text="TU PROGRESO"
                               FontSize="9"
                               Foreground="#9988A8"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <!-- NAVEGACIÓN -->
            <StackPanel Grid.Row="1" Margin="15,25,15,0">

                <TextBlock Text="MENÚ PRINCIPAL"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#A18DAF"
                           Margin="12,0,0,13"/>

                <Button x:Name="btnInicio"
                        Content="⌂    Inicio"
                        Style="{StaticResource BotonMenu}"
                        Click="btnInicio_Click"/>

                <Button x:Name="btnMisiones"
                        Content="✧    Misiones"
                        Style="{StaticResource BotonMenu}"
                        Click="btnMisiones_Click"/>

                <Button x:Name="btnLogros"
                        Content="◇    Logros"
                        Style="{StaticResource BotonMenu}"
                        Click="btnLogros_Click"/>

                <Button x:Name="btnActividad"
                        Content="◷    Actividad"
                        Style="{StaticResource BotonMenu}"
                        Click="btnActividad_Click"/>

                <Button x:Name="btnPerfil"
                        Content="○    Perfil"
                        Style="{StaticResource BotonMenu}"
                        Click="btnPerfil_Click"/>

            </StackPanel>

            <!-- USUARIO -->
            <Border Grid.Row="2"
                    BorderBrush="#DCCFE7"
                    BorderThickness="0,1,0,0"
                    Padding="15">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- IMAGEN DEL USUARIO -->
                    <Border Width="37"
                            Height="37"
                            Background="#F9EAF1"
                            CornerRadius="20"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="9,0,0,0">

                        <TextBlock x:Name="txtNombreMenu"
                                   FontWeight="SemiBold"
                                   Foreground="#54376F"
                                   FontSize="12"/>

                        <TextBlock x:Name="txtEmailMenu"
                                   Foreground="#9988A8"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- ====================================== -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ====================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="29"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E9E0ED"
                    BorderThickness="0,0,0,1">

                <Grid Margin="30,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="txtTituloPagina"
                                   Text="Inicio"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#54376F"/>

                        <TextBlock Text="Panel de jugador"
                                   FontSize="11"
                                   Foreground="#A399A9"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F9EAF1"
                            CornerRadius="15"
                            Padding="13,7"
                            VerticalAlignment="Center">

                        <TextBlock x:Name="txtNivelSuperior"
                                   Foreground="#A6537C"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>

                </Grid>
            </Border>

            <!-- ================================== -->
            <!-- CONTENEDOR DE LAS VISTAS -->
            <!-- ================================== -->

            <ContentControl x:Name="ContenedorVistas"
                            Grid.Row="1"
                            Margin="25,20,25,15"/>

            <!-- ================================== -->
            <!-- BARRA INFERIOR -->
            <!-- ================================== -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E9E0ED"
                    BorderThickness="0,1,0,0">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtEstado"
                               FontSize="10"
                               Foreground="#918797"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="LevelUp"
                               FontSize="10"
                               Foreground="#A18DAF"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>

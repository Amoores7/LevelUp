<Window x:Class="LevelUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LevelUp"
        WindowState="Maximized"
        MinWidth="1100"
        MinHeight="700"
        Background="#F8F5FA">

    <Window.Resources>

        <!-- COLORES -->
        <SolidColorBrush x:Key="Morado" Color="#7954A1"/>
        <SolidColorBrush x:Key="MoradoOscuro" Color="#54376F"/>
        <SolidColorBrush x:Key="Lavanda" Color="#EEE5F5"/>
        <SolidColorBrush x:Key="Rosa" Color="#E9A9C5"/>
        <SolidColorBrush x:Key="RosaClaro" Color="#F9EAF1"/>
        <SolidColorBrush x:Key="Fondo" Color="#F8F5FA"/>
        <SolidColorBrush x:Key="Texto" Color="#382D43"/>
        <SolidColorBrush x:Key="Secundario" Color="#918797"/>
        <SolidColorBrush x:Key="Borde" Color="#E9E0ED"/>

        <!-- BOTONES DE NAVEGACIÓN -->
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Height" Value="47"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#655575"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5D9EF"/>
                    <Setter Property="Foreground" Value="#54376F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="BotonMorado" TargetType="Button">
            <Setter Property="Height" Value="37"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#7954A1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#68438F"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- BOTÓN SECUNDARIO -->
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Height" Value="37"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="#F0E9F5"/>
            <Setter Property="Foreground" Value="#684B83"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3D5ED"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CAMPOS -->
        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="#FBF9FC"/>
            <Setter Property="BorderBrush" Value="#E5DAEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#382D43"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ENCABEZADOS DE SECCIÓN -->
        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#382D43"/>
        </Style>

        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#918797"/>
        </Style>

        <!-- TABLAS -->
        <Style x:Key="Tabla" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#493B53"/>
            <Setter Property="BorderBrush" Value="#E9E0ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBF8FC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0EAF3"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F0EAF3"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="39"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENÚ LATERAL -->
        <Grid Grid.Column="0" Background="#EEE5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="105"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <!-- LOGOTIPO -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="43"
                        Height="43"
                        Background="#7954A1"
                        CornerRadius="11">
                    <TextBlock Text="L"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="LevelUp"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#54376F"/>
                    <TextBlock Text="TU PROGRESO"
                               FontSize="9"
                               Foreground="#9988A8"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <!-- NAVEGACIÓN -->
            <StackPanel Grid.Row="1" Margin="15,25,15,0">

                <TextBlock Text="MENÚ PRINCIPAL"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#A18DAF"
                           Margin="12,0,0,13"/>

                <Button x:Name="btnInicio"
                        Content="⌂    Inicio"
                        Style="{StaticResource BotonMenu}"/>

                <Button x:Name="btnMisiones"
                        Content="✧    Misiones"
                        Style="{StaticResource BotonMenu}"/>

                <Button x:Name="btnLogros"
                        Content="◇    Logros"
                        Style="{StaticResource BotonMenu}"/>

                <Button x:Name="btnActividad"
                        Content="◷    Actividad"
                        Style="{StaticResource BotonMenu}"/>

                <Button x:Name="btnPerfil"
                        Content="○    Perfil"
                        Style="{StaticResource BotonMenu}"/>

            </StackPanel>

            <!-- USUARIO -->
            <Border Grid.Row="2"
                    BorderBrush="#DCCFE7"
                    BorderThickness="0,1,0,0"
                    Padding="15">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="25"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="37"
                            Height="37"
                            Background="#E9A9C5"
                            CornerRadius="20">
                        <TextBlock Text="●"
                                   FontSize="19"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="9,0,0,0">
                        <TextBlock x:Name="txtNombreMenu"
                                   Text="{Binding Usuario.Nombre}"
                                   FontWeight="SemiBold"
                                   Foreground="#54376F"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding Usuario.Email}"
                                   Foreground="#9988A8"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="⋮"
                               FontSize="21"
                               Foreground="#7954A1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                </Grid>
            </Border>

        </Grid>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Column="1" Margin="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="29"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E9E0ED"
                    BorderThickness="0,0,0,1">

                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LevelUp"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#54376F"/>
                        <TextBlock Text="Panel de jugador"
                                   FontSize="11"
                                   Foreground="#A399A9"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Background="#F9EAF1"
                                CornerRadius="15"
                                Padding="13,7">
                            <TextBlock Text="{Binding Usuario.Nivel, StringFormat=Nivel {0}}"
                                       Foreground="#A6537C"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- TABCONTROL -->
            <TabControl x:Name="tabPrincipal"
                        Grid.Row="1"
                        Margin="25,20,25,15"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectedIndex="0">

                <!-- ================= INICIO ================= -->
                <TabItem Header="Inicio">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="5,15,5,20">

                            <TextBlock Text="Inicio"
                                       Style="{StaticResource TituloSeccion}"/>

                            <TextBlock Text="Resumen de tu progreso"
                                       Style="{StaticResource Subtitulo}"
                                       Margin="0,5,0,25"/>

                            <!-- PROGRESO DEL JUGADOR -->
                            <Border Background="#7954A1"
                                    CornerRadius="13"
                                    Padding="25"
                                    Margin="0,0,0,22">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Usuario.Nombre}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>

                                        <TextBlock Text="{Binding Usuario.Email}"
                                                   Foreground="#E4D8EE"
                                                   FontSize="12"
                                                   Margin="0,5,0,18"/>

                                        <TextBlock Text="{Binding Usuario.Experiencia, StringFormat=Experiencia: {0}}"
                                                   Foreground="White"
                                                   FontSize="13"/>

                                        <ProgressBar Height="9"
                                                     Width="250"
                                                     HorizontalAlignment="Left"
                                                     Margin="0,10,0,0"
                                                     Maximum="{Binding ExperienciaNecesaria}"
                                                     Value="{Binding Usuario.Experiencia}"
                                                     Background="#A98BC4"
                                                     Foreground="#E9A9C5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">

                                        <TextBlock Text="NIVEL"
                                                   FontSize="11"
                                                   Foreground="#E4D8EE"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding Usuario.Nivel}"
                                                   FontSize="65"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>

                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ESTADÍSTICAS -->
                            <Grid Margin="0,0,0,23">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="White"
                                        BorderBrush="#E9E0ED"
                                        BorderThickness="1"
                                        Padding="18"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="PUNTOS"
                                                   Foreground="#A18DAF"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Usuario.Puntos}"
                                                   FontSize="29"
                                                   FontWeight="Bold"
                                                   Foreground="#7954A1"
                                                   Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#F9EAF1"
                                        Padding="18"
                                        Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="MISIONES COMPLETADAS"
                                                   Foreground="#B16D8D"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TotalMisionesCompletadas}"
                                                   FontSize="29"
                                                   FontWeight="Bold"
                                                   Foreground="#A6537C"
                                                   Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="#EEE5F5"
                                        Padding="18"
                                        Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LOGROS"
                                                   Foreground="#9479A7"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TotalLogros}"
                                                   FontSize="29"
                                                   FontWeight="Bold"
                                                   Foreground="#7954A1"
                                                   Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ÚLTIMAS MISIONES -->
                            <TextBlock Text="Misiones recientes"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#493B53"
                                       Margin="0,0,0,12"/>

                            <DataGrid Style="{StaticResource Tabla}"
                                      ItemsSource="{Binding MisionesRecientes}"
                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Misión"
                                                        Binding="{Binding Titulo}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Categoría"
                                                        Binding="{Binding Categoria}"
                                                        Width="150"/>
                                    <DataGridTextColumn Header="Experiencia"
                                                        Binding="{Binding Experiencia}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Estado"
                                                        Binding="{Binding Estado}"
                                                        Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ================= MISIONES ================= -->
                <TabItem Header="Misiones">

                    <Grid Margin="5,15,5,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Misiones"
                                       Style="{StaticResource TituloSeccion}"/>
                            <TextBlock Text="Gestiona tus objetivos y registra tu progreso"
                                       Style="{StaticResource Subtitulo}"
                                       Margin="0,5,0,20"/>
                        </StackPanel>

                        <!-- FILTROS -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtBuscarMision"
                                     Style="{StaticResource Campo}"
                                     ToolTip="Buscar misión"
                                     VerticalAlignment="Center"/>

                            <ComboBox x:Name="cmbFiltroEstado"
                                      Grid.Column="1"
                                      Height="36"
                                      Margin="10,0"
                                      VerticalContentAlignment="Center"
                                      Background="#FBF9FC"
                                      BorderBrush="#E5DAEB"
                                      Padding="7"
                                      ToolTip="Filtrar por estado"/>

                            <ComboBox x:Name="cmbFiltroCategoria"
                                      Grid.Column="2"
                                      Height="36"
                                      Margin="5,0,10,0"
                                      VerticalContentAlignment="Center"
                                      Background="#FBF9FC"
                                      BorderBrush="#E5DAEB"
                                      Padding="7"
                                      ToolTip="Filtrar por categoría"/>

                            <Button x:Name="btnActualizarMisiones"
                                    Grid.Column="3"
                                    Content="↻  Actualizar"
                                    Style="{StaticResource BotonSecundario}"/>
                        </Grid>

                        <!-- LISTADO Y DETALLE -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#E9E0ED"
                                    BorderThickness="1">

                                <DataGrid x:Name="dgMisiones"
                                          Style="{StaticResource Tabla}"
                                          ItemsSource="{Binding Misiones}"
                                          SelectedItem="{Binding MisionSeleccionada}">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Título"
                                                            Binding="{Binding Titulo}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Categoría"
                                                            Binding="{Binding Categoria}"
                                                            Width="115"/>

                                        <DataGridTextColumn Header="Experiencia"
                                                            Binding="{Binding Experiencia}"
                                                            Width="105"/>

                                        <DataGridTextColumn Header="Fecha"
                                                            Binding="{Binding Fecha}"
                                                            Width="115"/>

                                        <DataGridTextColumn Header="Estado"
                                                            Binding="{Binding Estado}"
                                                            Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- DETALLE -->
                            <Border Grid.Column="2"
                                    Background="#F9F5FB"
                                    BorderBrush="#E9E0ED"
                                    BorderThickness="1"
                                    Padding="18">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>

                                        <TextBlock Text="Detalle de misión"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#54376F"
                                                   Margin="0,0,0,18"/>

                                        <TextBlock Text="Título"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#918797"/>

                                        <TextBox x:Name="txtTituloMision"
                                                 Style="{StaticResource Campo}"
                                                 Margin="0,6,0,14"
                                                 Text="{Binding MisionSeleccionada.Titulo, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Descripción"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#918797"/>

                                        <TextBox x:Name="txtDescripcionMision"
                                                 Height="80"
                                                 Padding="9"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="#FBF9FC"
                                                 BorderBrush="#E5DAEB"
                                                 BorderThickness="1"
                                                 Margin="0,6,0,14"
                                                 Text="{Binding MisionSeleccionada.Descripcion, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Categoría"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#918797"/>

                                        <ComboBox x:Name="cmbCategoriaMision"
                                                  Height="36"
                                                  Margin="0,6,0,14"
                                                  Padding="7"
                                                  Background="White"
                                                  BorderBrush="#E5DAEB"
                                                  SelectedItem="{Binding MisionSeleccionada.Categoria}"/>

                                        <TextBlock Text="Experiencia"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#918797"/>

                                        <TextBox x:Name="txtExperienciaMision"
                                                 Style="{StaticResource Campo}"
                                                 Margin="0,6,0,14"
                                                 Text="{Binding MisionSeleccionada.Experiencia, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Fecha"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#918797"/>

                                        <DatePicker x:Name="dpFechaMision"
                                                    Height="36"
                                                    Margin="0,6,0,14"
                                                    SelectedDate="{Binding MisionSeleccionada.Fecha}"/>

                                        <TextBlock Text="Estado"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#918797"/>

                                        <ComboBox x:Name="cmbEstadoMision"
                                                  Height="36"
                                                  Margin="0,6,0,15"
                                                  Padding="7"
                                                  Background="White"
                                                  BorderBrush="#E5DAEB"
                                                  SelectedItem="{Binding MisionSeleccionada.Estado}"/>

                                        <Separator Margin="0,5,0,12"
                                                   Background="#E5DAEB"/>

                                        <WrapPanel HorizontalAlignment="Center">
                                            <Button x:Name="btnNuevoMision"
                                                    Content="+ Nuevo"
                                                    Style="{StaticResource BotonMorado}"/>

                                            <Button x:Name="btnGuardarMision"
                                                    Content="Guardar"
                                                    Style="{StaticResource BotonMorado}"/>

                                            <Button x:Name="btnModificarMision"
                                                    Content="Modificar"
                                                    Style="{StaticResource BotonSecundario}"/>

                                            <Button x:Name="btnEliminarMision"
                                                    Content="Eliminar"
                                                    Style="{StaticResource BotonSecundario}"/>

                                            <Button x:Name="btnLimpiarMision"
                                                    Content="Limpiar"
                                                    Style="{StaticResource BotonSecundario}"/>
                                        </WrapPanel>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- TOTAL -->
                        <TextBlock Grid.Row="3"
                                   Text="{Binding TotalMisiones, StringFormat=Total de misiones: {0}}"
                                   Foreground="#918797"
                                   FontSize="12"
                                   Margin="2,12,0,0"/>

                    </Grid>
                </TabItem>

                <!-- ================= LOGROS ================= -->
                <TabItem Header="Logros">

                    <Grid Margin="5,15,5,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Logros"
                                       Style="{StaticResource TituloSeccion}"/>
                            <TextBlock Text="Consulta los logros de tu progreso"
                                       Style="{StaticResource Subtitulo}"
                                       Margin="0,5,0,20"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtBuscarLogro"
                                     Style="{StaticResource Campo}"
                                     ToolTip="Buscar logro"/>

                            <ComboBox x:Name="cmbFiltroLogros"
                                      Grid.Column="1"
                                      Height="36"
                                      Margin="10,0"
                                      Padding="7"
                                      Background="White"
                                      BorderBrush="#E5DAEB"
                                      ToolTip="Filtrar logros"/>

                            <Button x:Name="btnActualizarLogros"
                                    Grid.Column="2"
                                    Content="↻  Actualizar"
                                    Style="{StaticResource BotonSecundario}"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="White"
                                BorderBrush="#E9E0ED"
                                BorderThickness="1">

                            <DataGrid x:Name="dgLogros"
                                      Style="{StaticResource Tabla}"
                                      ItemsSource="{Binding Logros}"
                                      SelectedItem="{Binding LogroSeleccionado}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Logro"
                                                        Binding="{Binding Titulo}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Descripción"
                                                        Binding="{Binding Descripcion}"
                                                        Width="2*"/>

                                    <DataGridTextColumn Header="Experiencia"
                                                        Binding="{Binding Experiencia}"
                                                        Width="130"/>

                                    <DataGridTextColumn Header="Estado"
                                                        Binding="{Binding Estado}"
                                                        Width="140"/>

                                    <DataGridTextColumn Header="Fecha"
                                                        Binding="{Binding Fecha}"
                                                        Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding TotalLogros, StringFormat=Total de logros: {0}}"
                                   Foreground="#918797"
                                   FontSize="12"
                                   Margin="2,12,0,0"/>

                    </Grid>
                </TabItem>

                <!-- ================= ACTIVIDAD ================= -->
                <TabItem Header="Actividad">

                    <Grid Margin="5,15,5,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Actividad"
                                       Style="{StaticResource TituloSeccion}"/>
                            <TextBlock Text="Historial de tus acciones y progresos"
                                       Style="{StaticResource Subtitulo}"
                                       Margin="0,5,0,20"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtBuscarActividad"
                                     Style="{StaticResource Campo}"
                                     ToolTip="Buscar actividad"/>

                            <DatePicker x:Name="dpFiltroActividad"
                                        Grid.Column="1"
                                        Height="36"
                                        Margin="10,0"
                                        SelectedDateFormat="Short"/>

                            <Button x:Name="btnActualizarActividad"
                                    Grid.Column="2"
                                    Content="↻  Actualizar"
                                    Style="{StaticResource BotonSecundario}"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="White"
                                BorderBrush="#E9E0ED"
                                BorderThickness="1">

                            <DataGrid x:Name="dgActividad"
                                      Style="{StaticResource Tabla}"
                                      ItemsSource="{Binding Actividades}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha"
                                                        Binding="{Binding Fecha}"
                                                        Width="180"/>

                                    <DataGridTextColumn Header="Actividad"
                                                        Binding="{Binding Descripcion}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Tipo"
                                                        Binding="{Binding Tipo}"
                                                        Width="160"/>

                                    <DataGridTextColumn Header="Experiencia"
                                                        Binding="{Binding Experiencia}"
                                                        Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding TotalActividades, StringFormat=Total de actividades: {0}}"
                                   Foreground="#918797"
                                   FontSize="12"
                                   Margin="2,12,0,0"/>

                    </Grid>
                </TabItem>

                <!-- ================= PERFIL ================= -->
                <TabItem Header="Perfil">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="5,15,5,20">

                            <TextBlock Text="Mi perfil"
                                       Style="{StaticResource TituloSeccion}"/>

                            <TextBlock Text="Información de tu cuenta y progreso"
                                       Style="{StaticResource Subtitulo}"
                                       Margin="0,5,0,25"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- PERFIL IZQUIERDO -->
                                <Border Grid.Column="0"
                                        Background="#EEE5F5"
                                        Padding="22"
                                        Margin="0,0,15,0">

                                    <StackPanel HorizontalAlignment="Center">

                                        <Border Width="105"
                                                Height="105"
                                                Background="#E9A9C5"
                                                CornerRadius="55"
                                                Margin="0,10,0,18">
                                            <TextBlock Text="●"
                                                       FontSize="48"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="{Binding Usuario.Nombre}"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   Foreground="#54376F"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>

                                        <TextBlock Text="{Binding Usuario.Email}"
                                                   FontSize="11"
                                                   Foreground="#9988A8"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,18"/>

                                        <Border Background="#7954A1"
                                                CornerRadius="8"
                                                Padding="17,10">
                                            <StackPanel>
                                                <TextBlock Text="NIVEL ACTUAL"
                                                           FontSize="10"
                                                           Foreground="#E4D8EE"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Usuario.Nivel}"
                                                           FontSize="34"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Border>

                                <!-- INFORMACIÓN -->
                                <Border Grid.Column="1"
                                        Background="White"
                                        BorderBrush="#E9E0ED"
                                        BorderThickness="1"
                                        Padding="25">

                                    <StackPanel>

                                        <TextBlock Text="Datos personales"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#54376F"
                                                   Margin="0,0,0,22"/>

                                        <TextBlock Text="Nombre"
                                                   Foreground="#918797"
                                                   FontSize="12"/>

                                        <TextBox x:Name="txtNombrePerfil"
                                                 Style="{StaticResource Campo}"
                                                 Margin="0,7,0,17"
                                                 Text="{Binding Usuario.Nombre, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Correo electrónico"
                                                   Foreground="#918797"
                                                   FontSize="12"/>

                                        <TextBox x:Name="txtCorreoPerfil"
                                                 Style="{StaticResource Campo}"
                                                 Margin="0,7,0,17"
                                                 IsReadOnly="True"
                                                 Text="{Binding Usuario.Email}"/>

                                        <Separator Background="#E9E0ED"
                                                   Margin="0,8,0,20"/>

                                        <TextBlock Text="Progreso"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#54376F"
                                                   Margin="0,0,0,18"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Experiencia"
                                                           Foreground="#918797"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding Usuario.Experiencia}"
                                                           Foreground="#7954A1"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Puntos"
                                                           Foreground="#918797"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding Usuario.Puntos}"
                                                           Foreground="#A6537C"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button x:Name="btnGuardarPerfil"
                                                Content="Guardar cambios"
                                                Style="{StaticResource BotonMorado}"
                                                HorizontalAlignment="Left"
                                                Margin="0,25,0,0"/>

                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- ESTADO DE LA APLICACIÓN -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E9E0ED"
                    BorderThickness="0,1,0,0">

                <Grid Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtEstado"
                               Text="{Binding EstadoAplicacion}"
                               FontSize="10"
                               Foreground="#918797"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="LevelUp"
                               FontSize="10"
                               Foreground="#A18DAF"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>

<Window x:Class="LevelUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vistas="clr-namespace:LevelUp.Views"
        Title="LevelUp" WindowState="Maximized" MinWidth="1000" MinHeight="600"
        Background="#F4F1FA">

    <Window.Resources>
        <!-- Colores -->
        <SolidColorBrush x:Key="MoradoOscuro" Color="#4A2E75"/>
        <SolidColorBrush x:Key="MoradoClaro" Color="#E5D9EF"/>

        <!-- Conversor del calendario -->
        <vistas:DiaConActividadConverter x:Key="DiaConActividad"/>

        <!-- Días del calendario con actividad -->
        <Style x:Key="DiaCalendarioStyle" TargetType="CalendarDayButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource DiaConActividad}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource MoradoClaro}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Botón del menú -->
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botón normal -->
        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MoradoOscuro}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== MENÚ LATERAL ===================== -->
        <Border Grid.Column="0" Background="{StaticResource MoradoOscuro}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="15,25,15,25">
                    <TextBlock Text="LevelUp" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock x:Name="txtNombreMenu" Foreground="White" FontSize="14" Margin="0,15,0,0"/>
                    <TextBlock x:Name="txtEmailMenu" Foreground="#D8CCF0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,15">
                    <!-- Perfil: abre la ventana PerfilWindow -->
                    <Button x:Name="btnPerfil" Content="Perfil"
                            Style="{StaticResource BotonMenu}" Click="btnPerfil_Click"/>
                    <Button x:Name="btnCerrarSesion" Content="Cerrar sesión"
                            Style="{StaticResource BotonMenu}" Click="btnCerrarSesion_Click"/>
                </StackPanel>

                <StackPanel>
                    <Button x:Name="btnInicio"    Content="Inicio"    Style="{StaticResource BotonMenu}" Click="btnInicio_Click"/>
                    <Button x:Name="btnMisiones"  Content="Misiones"  Style="{StaticResource BotonMenu}" Click="btnMisiones_Click"/>
                    <Button x:Name="btnLogros"    Content="Logros"    Style="{StaticResource BotonMenu}" Click="btnLogros_Click"/>
                    <Button x:Name="btnActividad" Content="Actividad" Style="{StaticResource BotonMenu}" Click="btnActividad_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== ZONA DERECHA ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0D9F0" BorderThickness="0,0,0,1">
                <Grid Margin="25,0">
                    <TextBlock x:Name="txtTituloPagina" Text="Inicio" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource MoradoOscuro}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtNivelSuperior" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Contenido: las 4 vistas ocupan el mismo sitio -->
            <Grid Grid.Row="1">

                <!-- ===================== VISTA INICIO ===================== -->
                <Grid x:Name="vistaInicio" Visibility="Visible" Margin="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,15">
                        <TextBlock x:Name="txtNombreInicio" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="txtEmailInicio" Foreground="Gray"/>
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nivel " FontWeight="Bold"/>
                                <TextBlock x:Name="txtNivel" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtExperiencia"/>
                            </StackPanel>
                            <ProgressBar x:Name="barraExperiencia" Height="18" Margin="0,6,0,10"
                                         Foreground="{StaticResource MoradoOscuro}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="XP total: "/>
                                <TextBlock x:Name="txtTotalXP" Margin="0,0,25,0"/>
                                <TextBlock Text="Misiones: "/>
                                <TextBlock x:Name="txtTotalMisiones" Margin="0,0,25,0"/>
                                <TextBlock Text="Logros: "/>
                                <TextBlock x:Name="txtTotalLogros"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Retos de hoy" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                            <TextBlock DockPanel.Dock="Top" x:Name="txtRetosHoyVacio" Text="No hay retos para hoy" Foreground="Gray"/>
                            <ListBox x:Name="listaRetosHoy" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding EstadoTexto}" Margin="0,0,10,0" Foreground="Gray"/>
                                                <TextBlock Text="{Binding Experiencia}" Foreground="{StaticResource MoradoOscuro}"/>
                                                <TextBlock Text=" XP" Foreground="{StaticResource MoradoOscuro}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="8,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Próximas misiones" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                            <TextBlock DockPanel.Dock="Top" x:Name="txtProximasVacio" Text="No hay misiones próximas" Foreground="Gray"/>
                            <ListBox x:Name="listaProximas" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FechaLimiteTexto}" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ===================== VISTA MISIONES ===================== -->
                <Grid x:Name="vistaMisiones" Visibility="Collapsed" Margin="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,20,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="txtBuscarMision" Width="200" Padding="4" TextChanged="FiltroMisiones_Changed"/>
                            <ComboBox x:Name="cmbFiltroEstado" Width="140" Margin="10,0"
                                      SelectionChanged="FiltroMisiones_Changed"/>
                            <Button x:Name="btnActualizarMisiones" Content="Actualizar"
                                    Style="{StaticResource BotonAccion}" Click="btnActualizar_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Total: "/>
                            <TextBlock x:Name="txtTotalMisionesListado"/>
                        </StackPanel>
                        <Grid>
                            <ListView x:Name="listaMisiones" SelectionChanged="listaMisiones_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Título"       DisplayMemberBinding="{Binding Titulo}" Width="170"/>
                                        <GridViewColumn Header="Categoría"    DisplayMemberBinding="{Binding Categoria}" Width="100"/>
                                        <GridViewColumn Header="Tipo"         DisplayMemberBinding="{Binding Tipo}" Width="80"/>
                                        <GridViewColumn Header="Estado"       DisplayMemberBinding="{Binding EstadoTexto}" Width="90"/>
                                        <GridViewColumn Header="XP"           DisplayMemberBinding="{Binding Experiencia}" Width="50"/>
                                        <GridViewColumn Header="Fecha límite" DisplayMemberBinding="{Binding FechaLimiteTexto}" Width="110"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="txtMisionesVacia" Text="No hay misiones" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </DockPanel>

                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="txtInfoMision" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>
                                <TextBlock Text="Título" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtTituloMision" Padding="4"/>
                                <TextBlock Text="Descripción" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtDescripcionMision" Padding="4" TextWrapping="Wrap"
                                         AcceptsReturn="True" Height="60"/>
                                <TextBlock Text="Categoría" Style="{StaticResource Etiqueta}"/>
                                <ComboBox x:Name="cmbCategoriaMision"/>
                                <TextBlock Text="Tipo" Style="{StaticResource Etiqueta}"/>
                                <ComboBox x:Name="cmbTipoMision"/>
                                <TextBlock Text="Estado" Style="{StaticResource Etiqueta}"/>
                                <ComboBox x:Name="cmbEstadoMision"/>
                                <TextBlock Text="Experiencia" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtExperienciaMision" Padding="4"/>
                                <TextBlock Text="Fecha límite" Style="{StaticResource Etiqueta}"/>
                                <DatePicker x:Name="dpFechaMision"/>

                                <WrapPanel Margin="0,15,0,0">
                                    <Button x:Name="btnNuevoMision"     Content="Nuevo"     Style="{StaticResource BotonAccion}" Click="btnNuevoMision_Click"/>
                                    <Button x:Name="btnGuardarMision"   Content="Guardar"   Style="{StaticResource BotonAccion}" Click="btnGuardarMision_Click"/>
                                    <Button x:Name="btnModificarMision" Content="Modificar" Style="{StaticResource BotonAccion}" Click="btnModificarMision_Click"/>
                                    <Button x:Name="btnCompletarMision" Content="Completar" Style="{StaticResource BotonAccion}" Click="btnCompletarMision_Click"/>
                                    <Button x:Name="btnEliminarMision"  Content="Eliminar"  Style="{StaticResource BotonAccion}" Click="btnEliminarMision_Click"/>
                                    <Button x:Name="btnLimpiarMision"   Content="Limpiar"   Style="{StaticResource BotonAccion}" Click="btnLimpiarMision_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===================== VISTA LOGROS ===================== -->
                <Grid x:Name="vistaLogros" Visibility="Collapsed" Margin="25">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox x:Name="cmbFiltroLogros" Width="170"
                                      SelectionChanged="cmbFiltroLogros_SelectionChanged"/>
                            <Button x:Name="btnActualizarLogros" Content="Actualizar" Margin="10,0"
                                    Style="{StaticResource BotonAccion}" Click="btnActualizar_Click"/>
                            <TextBlock Text="Total: " VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTotalLogrosListado" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <ListBox x:Name="listaLogros" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6" Opacity="{Binding Opacidad}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icono}" FontSize="30" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Titulo}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Foreground="Gray"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Puntos}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding EstadoTexto}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="txtLogrosVacio" Text="No hay logros" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- ===================== VISTA ACTIVIDAD ===================== -->
                <Grid x:Name="vistaActividad" Visibility="Collapsed" Margin="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto" MinWidth="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <Calendar x:Name="calendarioActividad"
                                  CalendarDayButtonStyle="{StaticResource DiaCalendarioStyle}"
                                  SelectedDatesChanged="calendarioActividad_SelectedDatesChanged"/>
                        <Button x:Name="btnTodasFechas" Content="Todas las fechas" Margin="0,8"
                                Style="{StaticResource BotonAccion}" Click="btnTodasFechas_Click"/>
                        <TextBlock x:Name="txtResumenDia" TextWrapping="Wrap" MaxWidth="220"/>
                    </StackPanel>

                    <DockPanel Grid.Column="1" Margin="0,0,20,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="txtBuscarActividad" Width="220" Padding="4"
                                     TextChanged="FiltroActividades_Changed"/>
                            <Button x:Name="btnActualizarActividades" Content="Actualizar" Margin="10,0"
                                    Style="{StaticResource BotonAccion}" Click="btnActualizar_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Total: "/>
                            <TextBlock x:Name="txtTotalActividades"/>
                        </StackPanel>
                        <Grid>
                            <ListView x:Name="listaActividades" SelectionChanged="listaActividades_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Fecha"       DisplayMemberBinding="{Binding FechaTexto}" Width="90"/>
                                        <GridViewColumn Header="Misión"      DisplayMemberBinding="{Binding Mision}" Width="150"/>
                                        <GridViewColumn Header="Descripción" DisplayMemberBinding="{Binding Descripcion}" Width="220"/>
                                        <GridViewColumn Header="Tiempo"      DisplayMemberBinding="{Binding Tiempo}" Width="70"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="txtActividadesVacia" Text="No hay actividades" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </DockPanel>

                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Misión" Style="{StaticResource Etiqueta}"/>
                            <ComboBox x:Name="cmbMisionActividad"/>
                            <TextBlock Text="Descripción" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtDescripcionActividad" Padding="4" TextWrapping="Wrap"
                                     AcceptsReturn="True" Height="70"/>
                            <TextBlock Text="Tiempo (min)" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtTiempoActividad" Padding="4"/>
                            <TextBlock Text="Fecha" Style="{StaticResource Etiqueta}"/>
                            <DatePicker x:Name="dpFechaActividad"/>

                            <WrapPanel Margin="0,15,0,0">
                                <Button x:Name="btnNuevaActividad"     Content="Nueva"     Style="{StaticResource BotonAccion}" Click="btnNuevaActividad_Click"/>
                                <Button x:Name="btnGuardarActividad"   Content="Guardar"   Style="{StaticResource BotonAccion}" Click="btnGuardarActividad_Click"/>
                                <Button x:Name="btnModificarActividad" Content="Modificar" Style="{StaticResource BotonAccion}" Click="btnModificarActividad_Click"/>
                                <Button x:Name="btnEliminarActividad"  Content="Eliminar"  Style="{StaticResource BotonAccion}" Click="btnEliminarActividad_Click"/>
                                <Button x:Name="btnLimpiarActividad"   Content="Limpiar"   Style="{StaticResource BotonAccion}" Click="btnLimpiarActividad_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Barra de estado -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E0D9F0" BorderThickness="0,1,0,0">
                <TextBlock x:Name="txtEstado" Margin="25,0" VerticalAlignment="Center" Foreground="Gray"/>
            </Border>
        </Grid>
    </Grid>
</Window>
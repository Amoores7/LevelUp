<UserControl x:Class="LevelUp.Views.MisionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F5FA">

    <UserControl.Resources>

        <SolidColorBrush x:Key="Morado" Color="#7954A1"/>
        <SolidColorBrush x:Key="MoradoOscuro" Color="#54376F"/>
        <SolidColorBrush x:Key="Lavanda" Color="#EEE5F5"/>
        <SolidColorBrush x:Key="Rosa" Color="#E9A9C5"/>
        <SolidColorBrush x:Key="Fondo" Color="#F8F5FA"/>
        <SolidColorBrush x:Key="Texto" Color="#382D43"/>
        <SolidColorBrush x:Key="Secundario" Color="#918797"/>
        <SolidColorBrush x:Key="Borde" Color="#E9E0ED"/>

        <!-- Campos de texto -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#382D43"/>
            <Setter Property="Background" Value="#FAF8FC"/>
            <Setter Property="BorderBrush" Value="#E9E0ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Botón principal -->
        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#7954A1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#EEE5F5"/>
            <Setter Property="Foreground" Value="#7954A1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Misiones"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="{StaticResource Texto}"/>

                <TextBlock Text="Organiza tus objetivos y completa nuevas misiones."
                           FontSize="13"
                           Foreground="{StaticResource Secundario}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- FILTROS -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource Borde}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,18">

            <WrapPanel VerticalAlignment="Center">

                <Button Content="Todas"
                        Style="{StaticResource BotonPrincipal}"
                        Width="85"
                        Margin="0,0,8,0"/>

                <Button Content="Pendientes"
                        Style="{StaticResource BotonSecundario}"
                        Margin="0,0,8,0"/>

                <Button Content="En progreso"
                        Style="{StaticResource BotonSecundario}"
                        Margin="0,0,8,0"/>

                <Button Content="Completadas"
                        Style="{StaticResource BotonSecundario}"/>

            </WrapPanel>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LISTA DE MISIONES -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Listado de misiones"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{StaticResource Texto}"
                               Margin="0,0,0,15"/>

                    <ListView x:Name="lstMisiones"
                              Grid.Row="1"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#FAF8FC"
                                        BorderBrush="#E9E0ED"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="{Binding Nombre}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#382D43"/>

                                            <TextBlock Text="{Binding Descripcion}"
                                                       FontSize="12"
                                                       Foreground="#918797"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,8"/>

                                            <TextBlock Text="{Binding Estado}"
                                                       FontSize="11"
                                                       Foreground="#7954A1"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">

                                            <TextBlock Text="{Binding Recompensa, StringFormat={}{0} XP}"
                                                       Foreground="#7954A1"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       HorizontalAlignment="Right"/>

                                        </StackPanel>

                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>
                </Grid>
            </Border>

            <!-- PANEL DE GESTIÓN -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Gestionar misión"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Texto}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Nombre de la misión"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Texto}"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="txtNombreMision"
                                 Style="{StaticResource CampoTexto}"/>

                        <TextBlock Text="Descripción"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Texto}"
                                   Margin="0,15,0,7"/>

                        <TextBox x:Name="txtDescripcionMision"
                                 Height="75"
                                 Padding="10"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#FAF8FC"
                                 BorderBrush="#E9E0ED"
                                 BorderThickness="1"/>

                        <TextBlock Text="Categoría"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Texto}"
                                   Margin="0,15,0,7"/>

                        <ComboBox x:Name="cmbCategoria"
                                  Height="38"
                                  Padding="8"
                                  FontSize="13"
                                  Background="#FAF8FC"
                                  BorderBrush="#E9E0ED">
                            <ComboBoxItem Content="Estudios"/>
                            <ComboBoxItem Content="Salud"/>
                            <ComboBoxItem Content="Personal"/>
                            <ComboBoxItem Content="Trabajo"/>
                            <ComboBoxItem Content="Otros"/>
                        </ComboBox>

                        <TextBlock Text="Recompensa (XP)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Texto}"
                                   Margin="0,15,0,7"/>

                        <TextBox x:Name="txtRecompensa"
                                 Style="{StaticResource CampoTexto}"/>

                        <TextBlock Text="Objetivo"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Texto}"
                                   Margin="0,15,0,7"/>

                        <TextBox x:Name="txtObjetivo"
                                 Style="{StaticResource CampoTexto}"/>

                        <TextBlock Text="Estado"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Texto}"
                                   Margin="0,15,0,7"/>

                        <ComboBox x:Name="cmbEstado"
                                  Height="38"
                                  Padding="8"
                                  FontSize="13"
                                  Background="#FAF8FC"
                                  BorderBrush="#E9E0ED">
                            <ComboBoxItem Content="Pendiente"/>
                            <ComboBoxItem Content="En progreso"/>
                            <ComboBoxItem Content="Completada"/>
                        </ComboBox>

                        <Button x:Name="btnCrearMision"
                                Content="Crear misión"
                                Style="{StaticResource BotonPrincipal}"
                                Margin="0,22,0,0"/>

                        <Button x:Name="btnEditarMision"
                                Content="Guardar cambios"
                                Style="{StaticResource BotonSecundario}"
                                Margin="0,9,0,0"/>

                        <Button x:Name="btnEliminarMision"
                                Content="Eliminar misión"
                                Background="#F9EAF1"
                                Foreground="#C34E79"
                                Height="36"
                                BorderThickness="0"
                                Margin="0,9,0,0"/>

                        <Button x:Name="btnLimpiar"
                                Content="Limpiar formulario"
                                Background="Transparent"
                                Foreground="#918797"
                                Height="36"
                                BorderThickness="0"
                                Margin="0,5,0,0"/>

                    </StackPanel>

                </ScrollViewer>
            </Border>

        </Grid>

    </Grid>
</UserControl>
